# Application Settings
PROJECT_NAME=INSPECTRA
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=inspectra-sih-2026-super-secure-jwt-secret-key-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# Default PostgreSQL URL (docker or local postgres)
DATABASE_URL=postgresql://inspectra:inspectra@localhost:5432/inspectra_db
# For SQLite quick fallback if Postgres is unavailable in local testing:
# DATABASE_URL=sqlite:///./inspectra.db

# Storage
STORAGE_DIR=./uploads
PUBLIC_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
